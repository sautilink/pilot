{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sautilink-pilot",
  "main": "src/index.js",
  "compatibility_date": "2026-10-21",
  "keep_vars": true,
  "workers_dev": true,
  "routes": [{ "pattern": "pilot.sautilink.com", "custom_domain": true }],
  "vars": {
    "PUBLIC_BASE_URL": "https://pilot.sautilink.com",
    "BOT_USERNAME": "sautilinkpilotbot"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "sautilink-pilot-db",
    "migrations_dir": "migrations"
  }],
  "durable_objects": {
    "bindings": [{ "name": "GROUPS", "class_name": "GroupCoordinator" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GroupCoordinator"] }],
  "triggers": { "crons": ["*/10 * * * *", "17 2 * * *"] },
  "observability": { "enabled": true }
}
